SECRET_ENV = re.compile(r"(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|CREDENTIAL|PRIVATE_KEY|SESSION_KEY|AUTH)", re.I)


def worker_env() -> dict:
    """The caller's environment minus Claude session variables and anything secret-looking. Workers get their own
    credentials only through CODEX_HOME (or the provider key lane adds explicitly)."""
    return {k: v for k, v in os.environ.items()
            if not k.startswith(("CLAUDE_", "CLAUDECODE", "ANTHROPIC_", "OPENAI_API", "MCP_")) and not SECRET_ENV.search(k)}


def repo_rules(cwd: str) -> str:
    """The repo's own instruction files, since a lean claude -p run doesn't load them."""
    root = git(cwd, "rev-parse", "--show-toplevel") or cwd
    parts = []
    for name in ("CLAUDE.md", "AGENTS.md", ".claude/CLAUDE.md"):
        f = Path(root) / name
        if f.is_file():
            parts.append(f"## {f}\n{f.read_text(errors='replace')[:20000]}")
    return "\n\n".join(parts)


