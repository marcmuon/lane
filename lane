def parse_events(path: Path) -> dict:
    info = {"thread_id": None, "last_agent_message": None, "fatal": None, "usage": {}}
    try:
        fh = path.open(errors="replace")
    except OSError:
        return info
    with fh:
        for line in fh:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            t = ev.get("type")
            if t == "thread.started":
                info["thread_id"] = ev.get("thread_id")
            elif t == "item.completed" and (ev.get("item") or {}).get("type") == "agent_message":
                info["last_agent_message"] = ev["item"].get("text")
            elif t == "turn.failed":
                info["fatal"] = ((ev.get("error") or {}).get("message")) or "turn.failed"
            elif t == "turn.completed":
                for k, v in (ev.get("usage") or {}).items():
                    if isinstance(v, (int, float)):
                        info["usage"][k] = info["usage"].get(k, 0) + v
    return info


def first_line(text: str) -> str:
    for line in text.splitlines():
        if line.strip():
            return line.strip().strip("*").strip()
    return ""


def audit_tool_calls(path: Path) -> dict:
    """Read Claude stream-json, Codex exec items, or raw Codex rollout calls.

    Count call identities once across start/update/end events. Treat unknown
    Codex item types as forbidden, so newly introduced tools fail closed.
    """
    calls = {}
    try:
        fh = path.open(errors="replace")
    except OSError:
        return {"exa_calls": 0, "other_tools": []}
    with fh:
        for lineno, line in enumerate(fh):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if not isinstance(ev, dict):
                continue
            t = ev.get("type", "")
            items = []
            if t == "assistant":
                items = [b for b in (ev.get("message") or {}).get("content", [])
                         if b.get("type") in ("tool_use", "server_tool_use")]
            elif t == "stream_event":
                block = (ev.get("event") or {}).get("content_block") or {}
                if block.get("type") in ("tool_use", "server_tool_use"):
                    items = [block]
            elif t in ("item.started", "item.updated", "item.completed"):
                item = ev.get("item") or {}
                if item.get("type") not in ("agent_message", "reasoning", "error"):
                    items = [item]
            elif t == "response_item":
                item = ev.get("payload") or {}
                if item.get("type", "").endswith("_call"):
                    items = [item]
            elif t in ("function_call", "custom_tool_call", "local_shell_call", "web_search_call"):
                items = [ev]
            for index, item in enumerate(items):
                kind = item.get("type", "unknown")
                name = item.get("name") or kind
                if kind == "mcp_tool_call":
                    name = f"mcp__{item.get('server')}__{item.get('tool')}"
                elif item.get("namespace") == "mcp__exa" and name in EXA_TOOLS:
                    name = f"mcp__exa__{name}"
                elif item.get("namespace") == "functions" and name in EXA_TOOL_NAMES:
                    pass
                elif item.get("namespace"):
                    name = f"{item['namespace']}.{name}"
                call_id = item.get("call_id") or item.get("id") or f"line:{lineno}:{index}"
                # A server-side tool with an Exa-looking name is not an MCP call.
                if kind == "server_tool_use":
                    name = f"server_tool_use:{name}"
                calls[(call_id, name)] = name
    return {"exa_calls": sum(name in EXA_TOOL_NAMES for name in calls.values()),
            "other_tools": sorted({name for name in calls.values() if name not in EXA_TOOL_NAMES})}


def classify(rc: int | None, timed_out: bool, cancelled: bool, ev: dict, final_text: str, stderr_tail: str,
             kind: str, answer_only: bool = False) -> str:
    blob = f"{ev.get('fatal') or ''}\n{stderr_tail}".lower()
    if "hit your session limit" in blob or "hit your weekly limit" in blob:
        blob += " usage limit"
    if cancelled:
        return "cancelled"
    if timed_out:
        return "timeout"
    if "usage limit" in blob or "usage_limit" in blob:
        return "capped"
    if re.search(r"\b401\b", blob) or "unauthorized" in blob or "invalid api key" in blob:
        return "auth_401"
    if rc not in (0, None) or ev.get("fatal"):
        return "error"
    if not final_text.strip():
        return "no_report"
    if not answer_only and not MARKER[kind].fullmatch(first_line(final_text)):
        return "contract_violation"
    return "ok"


def rollout_facts(codex_home: str, thread_id: str | None) -> dict:
    facts = {"model_verified": None, "effort_recorded": None, "rollout": None}
    if not thread_id:
        return facts
    hits = glob.glob(os.path.join(codex_home, "sessions", "**", f"rollout-*{thread_id}.jsonl"), recursive=True)
    if not hits:
        return facts
    facts["rollout"] = hits[0]
    try:
        with open(hits[0], errors="replace") as fh:
            for line in fh:
                if '"turn_context"' not in line:
                    continue
                p = (json.loads(line).get("payload") or {})
                facts["model_verified"] = p.get("model")
                facts["effort_recorded"] = p.get("effort") or ((p.get("collaboration_mode") or {}).get("settings") or {}).get("reasoning_effort")
                break
    except (OSError, ValueError):
        pass
    return facts


def overlapping_lanes(run: Path, codex_home: str, start: float, end: float) -> int:
    """Other lanes on the same account whose run interval overlaps this one (for splitting account-wide deltas)."""
    me = account_id(codex_home)
    n = 0
    for st in RUNS.glob("*/status.json"):
        if st.parent == run:
            continue
        s = read_json(st) or {}
        p = read_json(st.parent / "params.json") or {}
        if p.get("provider") != "openai" or not p.get("codex_home") or account_id(p["codex_home"]) != me:
            continue
        s0, s1 = s.get("started_at"), s.get("finished_at") or time.time()
        if s0 and s0 < end and s1 > start:
            n += 1
    return n


# ---------- supervisor (runs detached; the only writer of status.json after launch) ----------

def supervise(lane_id: str) -> int:
    run = RUNS / lane_id
    p = read_json(run / "params.json")
    status = read_json(run / "status.json")
    if not p or not status:
        return 1
    status["supervisor_pid"] = os.getpid()
    write_json(run / "status.json", status)
    final_path, events_path, stderr_path = run / "final.md", run / "events.jsonl", run / "stderr.log"
    for f in (final_path, events_path, stderr_path):
        f.unlink(missing_ok=True)
    started = time.time()
    if (run / "cancel").exists():
        return finish(run, p, status, rc=None, timed_out=False, cancelled=True, started=started)
    try:
        argv, env = build_claude_argv(p, run) if p["provider"] == "claude" else build_argv(p, final_path)
    except UsageError as exc:
        return finish(run, p, status, rc=None, timed_out=False, cancelled=False, started=started, setup_error=str(exc))
    secret = env.get("LANE_SPARK_KEY") or (env.get("DEEPSEEK_API_KEY") if p["provider"] == "deepseek" else "") or ""
    write_json(run / "argv.json", {"argv": argv})
    if (run / "cancel").exists():      # a cancel may land while build_argv waits on Keychain
        return finish(run, p, status, rc=None, timed_out=False, cancelled=True, started=started)
    with (run / "brief.md").open("rb") as stdin, events_path.open("wb") as out, stderr_path.open("wb") as err:
        try:
            proc = subprocess.Popen(argv, cwd=p["cwd"], stdin=stdin, stdout=out, stderr=err, env=env,
                                    start_new_session=True)
        except FileNotFoundError:
            return finish(run, p, status, rc=None, timed_out=False, cancelled=False, started=started,
                          setup_error=f"{argv[0]} not found")
        timed_out = cancelled = False
        try:
            status.update(state="running", codex_pid=proc.pid, codex_pgid=proc.pid, started_at=started)
            write_json(run / "status.json", status)
            deadline = started + p["max_time_s"]
            while proc.poll() is None:
                if (run / "cancel").exists():
                    cancelled = True
                    break
                if time.time() >= deadline:
                    timed_out = True
                    break
                time.sleep(1)
            if p["provider"] == "claude" and proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGINT)   # claude -p records a result on SIGINT, not on SIGTERM
                    proc.wait(timeout=KILL_GRACE_S)
                except (ProcessLookupError, PermissionError, subprocess.TimeoutExpired):
                    pass
        finally:
            stopped = stop_group(proc.pid, reap=proc.poll)   # also stops descendants left behind after a normal exit
        try:
            proc.wait(timeout=KILL_GRACE_S)
        except subprocess.TimeoutExpired:
            pass
    return finish(run, p, status, rc=proc.returncode, timed_out=timed_out, cancelled=cancelled, started=started,
                  setup_error="" if stopped else STUCK_GROUP, stuck=not stopped, secret=secret)


STUCK_GROUP = "worker process group survived SIGKILL; its write roots stay reserved until it exits"


def finish(run: Path, p: dict, status: dict, rc, timed_out: bool, cancelled: bool, started: float,
           setup_error: str = "", stuck: bool = False, secret: str | None = None) -> int:
    is_claude = p["provider"] == "claude"
    scrub_run(run, secret if secret is not None else worker_secret(p))
    ev = parse_claude_events(run / "events.jsonl") if is_claude else parse_events(run / "events.jsonl")
    if is_claude:
        record_claude_rate(ev.get("rate"))
        if ev.get("error") in ("rate_limit",) and not ev.get("fatal"):
            ev["fatal"] = "usage limit (claude rate_limit)"
        if ev.get("error") in ("authentication_failed", "oauth_org_not_allowed", "account_on_hold") and not ev.get("fatal"):
            ev["fatal"] = "401 unauthorized (claude)"
    final_path = run / "final.md"
    final_text = final_path.read_text(errors="replace") if final_path.exists() and final_path.stat().st_mtime >= started - 1 else ""
    if not final_text.strip() and ev.get("last_agent_message"):
        final_text = ev["last_agent_message"]          # -o missed: fall back to the last agent message in the stream
        final_path.write_text(final_text)
    try:
        stderr_tail = (run / "stderr.log").read_text(errors="replace")[-4000:]
    except OSError:
        stderr_tail = ""
    state = "error" if setup_error else classify(rc, timed_out, cancelled, ev, final_text, stderr_tail, p["kind"],
                                                p.get("answer_only", False))
    facts = ({"model_verified": ev.get("model"), "effort_recorded": None, "rollout": None} if is_claude
             else rollout_facts(p["codex_home"], ev.get("thread_id")))
    audit = None
    if p.get("answer_only"):
        audit = audit_tool_calls(run / "events.jsonl")
        if facts.get("rollout"):
            # exec --json omits some tool types (e.g. view_image). The raw rollout
            # also records those calls. Its Exa calls duplicate the exec stream.
            raw = audit_tool_calls(Path(facts["rollout"]))
            audit["exa_calls"] = max(audit["exa_calls"], raw["exa_calls"])
            audit["other_tools"] = sorted(set(audit["other_tools"] + raw["other_tools"]))
        if audit["other_tools"] or (audit["exa_calls"] and not p.get("web_research")):
            state = "tool_used"
    after = latest_rate_limit(p["codex_home"], since=started - 5) if p["provider"] == "openai" else None
    before = p.get("quota_before") or {}
    ended = time.time()
    raw_delta = delta = None
    overlap = 0
    if after and isinstance(before.get("used_percent"), (int, float)) and before.get("resets_at") == after.get("resets_at"):
        raw_delta = round(after["used_percent"] - before["used_percent"], 2)
        overlap = overlapping_lanes(run, p["codex_home"], started, ended)
        delta = round(raw_delta / (1 + overlap), 2)     # approximate: the account delta is shared by overlapping lanes
    if state == "capped":
        try:
            capped_marker(p["codex_home"], p["provider"]).write_text(
                f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {(ev.get('fatal') or '')[:300]}\n")
        except OSError:
            pass
    head = first_line(final_text or "")
    result = {
        "lane_id": run.name, "status": state, "kind": p["kind"], "label": p["label"],
        "provider": p["provider"], "model": p["model"], "effort": p["effort"],
        "model_verified": facts["model_verified"], "effort_recorded": facts["effort_recorded"],
        "codex_home": p["codex_home"], "cwd": p["cwd"], "worktree": p.get("worktree"), "branch": p.get("branch"),
        "session_id": ev.get("thread_id"), "exit_code": rc, "duration_s": round(ended - started, 1),
        "tokens": ev.get("usage") or None, "report_path": str(final_path) if final_text else None,
        "marker": head if MARKER[p["kind"]].fullmatch(head) else None, "report_words": len((final_text or "").split()),
        "summary": "\n".join(x for x in (setup_error, final_text or ev.get("fatal") or
                                         (stderr_tail.strip() if state != "ok" else "")) if x),
        "quota_before": before.get("used_percent"), "quota_after": (after or {}).get("used_percent"),
        "quota_delta_raw": raw_delta, "quota_delta": delta, "overlapping_lanes": overlap,
        "run_dir": str(run), "finished_at": ended,
        "profile": p.get("profile"), "routing": p.get("routing"),
    }
    if audit is not None:
        result.update(answer_only=True, web_research=p.get("web_research", False),
                      exa_calls=audit["exa_calls"], disallowed_tools=audit["other_tools"],
                      reason="tool_used" if state == "tool_used" else None)
        if audit["exa_calls"] and not p.get("web_research"):
            result["disallowed_tools"] = sorted(set(result["disallowed_tools"] + ["exa"]))
    if p.get("answer_only") and not stuck:
        shutil.rmtree(p["cwd"], ignore_errors=True)
    write_json(run / "result.json", result)
    # a stuck group stays "running" so is_live() keeps its reservation while any member is alive
    status.update(state="running" if stuck else "done", result_status=state, finished_at=ended)
    write_json(run / "status.json", status)
    return 0


# ---------- commands ----------

def cmd_start(a: argparse.Namespace, wait_after: bool = False, route_only: bool = False) -> int:
    brief = Path(a.brief).expanduser().resolve()
    if a.web_research and not a.answer_only:
        raise UsageError("--web-research requires --answer-only")
    if a.answer_only and (a.worktree or a.network or a.add_dir or a.sandbox == "workspace-write"):
        raise UsageError("--answer-only cannot use --worktree, --network, --add-dir or --sandbox workspace-write")
    if not a.answer_only and not a.cwd:
        raise UsageError("--cwd is required unless --answer-only is set")
    cwd = None if a.answer_only else Path(a.cwd).expanduser().resolve()
    brief_text = brief.read_text(errors="replace") if brief.is_file() else ""
    if not brief_text.strip():
        return emit({"status": "usage_error", "error": f"brief missing or empty: {brief}"}, 2)
    if cwd is not None and not cwd.is_dir():
        return emit({"status": "usage_error", "error": f"cwd not a directory: {cwd}"}, 2)
    a.cwd = str(cwd) if cwd is not None else None
    routing, refusal = resolve_route(a, brief_text)
    if refusal:
        return emit(refusal, 2)
    if a.answer_only:
        # Profiles may select a model/effort, but cannot grant write access.
        a.sandbox, a.worktree = "read-only", False
    if route_only:
        return emit({"status": "routed", "profile": routing.get("profile"), "provider": a.provider, "model": a.model, "effort": a.effort,
                     "kind": a.kind, "sandbox": a.sandbox, "worktree": a.worktree, "max_time_s": a.max_time,
                     "routing": routing})
    add_dirs = [str(Path(d).expanduser().resolve()) for d in a.add_dir]
    missing = [d for d in add_dirs if not Path(d).is_dir()]
    if missing:
        return emit({"status": "usage_error", "error": f"--add-dir not a directory: {missing}"}, 2)
    codex_home = str(Path(a.codex_home or DEFAULT_HOME).expanduser().absolute())
    if a.provider == "openai" and not (Path(codex_home) / "auth.json").exists():
        return emit({"status": "usage_error", "error": f"no auth.json in {codex_home}"}, 2)
    endpoint = provider_endpoint(a.provider, a.cwd)
    if endpoint is not None:
        refusal = resolve_served_model(a, endpoint)
        if refusal:
            return emit(refusal, 4 if refusal["status"] == "provider_unavailable" else 2)
    elif a.model == "auto":
        return emit({"status": "usage_error", "error": f"model auto only works with a self-hosted provider, not {a.provider}"}, 2)
    repo = None if a.answer_only else git(cwd, "rev-parse", "--show-toplevel")
    if a.worktree and not repo:
        return emit({"status": "usage_error", "error": "--worktree needs cwd inside a git repo"}, 2)
    RUNS.mkdir(parents=True, exist_ok=True)
    lock_fh = (STATE / "lock").open("a+")
    deadline = time.time() + a.wait_slot
    while True:
        fcntl.flock(lock_fh, fcntl.LOCK_EX)
        running = running_lanes()
        if len(running) < MAX_CONCURRENT:
            break
        fcntl.flock(lock_fh, fcntl.LOCK_UN)
        if time.time() >= deadline:
            return emit({"status": "busy", "running": [r.get("lane_id") for r in running], "max": MAX_CONCURRENT}, 4)
        time.sleep(5)
    try:
        lane_id = new_id(a.label or brief.stem)
        worktree = branch = None
        if a.worktree:
            worktree = WORKTREE_ROOT / f"lane-{lane_id}"
            branch = f"lane/{lane_id}"
        # writable roots this lane reserves (one writer per root; overlapping roots clash)
        write_roots: list[str] = []
        if a.sandbox == "workspace-write":
            write_roots = [str(worktree) if worktree else (repo or str(cwd))] + add_dirs
            for r in running:
                for mine in write_roots:
                    for theirs in r.get("write_roots") or []:
                        if overlaps(mine, theirs):
                            return emit({"status": "busy_worktree", "error": f"{mine} overlaps {theirs}",
                                         "running": [r.get("lane_id")]}, 4)
        quota = latest_rate_limit(codex_home) if a.provider == "openai" else None
        refusal = None if a.force else preflight_refusal(a.provider, a.kind, codex_home, quota)
        if refusal:
            return emit(refusal, 5)
        work_cwd, git_dir = cwd, None
        if worktree:
            mk = subprocess.run(["git", "-C", repo, "worktree", "add", "-b", branch, str(worktree), "HEAD"],
                                capture_output=True, text=True)
            if mk.returncode != 0:
                return emit({"status": "error", "error": f"git worktree add failed: {mk.stderr.strip()[:300]}"}, 1)
        run, made_run, launched = RUNS / lane_id, False, False
        try:
            if worktree:
                work_cwd = worktree / cwd.relative_to(repo)
            if a.sandbox == "workspace-write" and repo:
                common = git(work_cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
                if common and not overlaps(common, str(worktree or repo)):
                    git_dir = common            # lets a worktree lane commit; not a reserved write root
            run.mkdir(parents=True)
            made_run = True
            if a.answer_only:
                work_cwd = Path(tempfile.mkdtemp(prefix="lane-answer-"))
            where = ""
            if worktree:   # briefs name the original checkout; some models go and work there
                where = (f"\n\n---\nWORKING COPY: you are in {work_cwd}, a git worktree of {repo} on branch {branch}. "
                         f"Read, edit, test and commit only there. Paths under {repo} in this brief mean the same "
                         f"files in your working copy. Never change {repo} itself.")
            (run / "brief.md").write_text(brief_text if a.answer_only else
                                         brief_text.rstrip() + where + CONTRACTS[a.kind] + "\n")
            params = {"kind": a.kind, "label": a.label or brief.stem, "provider": a.provider, "model": a.model,
                      "effort": a.effort, "sandbox": a.sandbox, "cwd": str(work_cwd), "codex_home": codex_home,
                      "tier": a.tier, "network": a.network, "add_dir": add_dirs, "git_dir": git_dir,
                      "max_time_s": a.max_time, "worktree": str(worktree) if worktree else None, "branch": branch,
                      "brief_source": str(brief), "quota_before": quota,
                      "profile": routing.get("profile"), "routing": routing, "rules_cwd": a.cwd,
                      "endpoint": endpoint}
            if a.answer_only:
                params.update(answer_only=True, web_research=a.web_research)
            write_json(run / "params.json", params)
            # reservation is published before the supervisor exists; from here on the supervisor owns status.json
            write_json(run / "status.json", {"lane_id": lane_id, "state": "starting", "write_roots": write_roots,
                                             "created_at": time.time()})
            with (run / "supervisor.log").open("ab") as slog:
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "_supervise", lane_id],
                                 stdin=subprocess.DEVNULL, stdout=slog, stderr=slog,
                                 start_new_session=True, close_fds=True)
                launched = True
        except BaseException:
            if not launched:                # after launch, the supervisor owns the worktree and run dir
                undo_start(repo, worktree, branch, run if made_run else None)
                if a.answer_only and work_cwd is not None:
                    shutil.rmtree(work_cwd, ignore_errors=True)
            raise
    finally:
        fcntl.flock(lock_fh, fcntl.LOCK_UN)
    if wait_after:
        return wait_for(lane_id, params["max_time_s"] + 120)
    return emit({"lane_id": lane_id, "status": "started", "run_dir": str(run), "model": a.model, "effort": a.effort,
                 "codex_home": codex_home,
                 "profile": routing.get("profile"), "routing": routing,
                 "worktree": params["worktree"], "branch": branch, "next": f"lane wait {lane_id} --max 540"})


def undo_start(repo: str | None, worktree: Path | None, branch: str | None, run: Path | None) -> None:
    """Remove what a failed start created, so it leaves no worktree, branch or reservation behind."""
    if worktree and repo:
        git(repo, "worktree", "remove", "--force", str(worktree))
        git(repo, "branch", "-D", branch)
    if run:
        shutil.rmtree(run, ignore_errors=True)


def wait_for(lane_id: str, max_s: float) -> int:
    run = RUNS / lane_id
    if not run.is_dir():
        return emit({"status": "usage_error", "error": f"unknown lane {lane_id}"}, 2)
    deadline = time.time() + max_s
    while True:
        res = read_json(run / "result.json")
        st = read_json(run / "status.json") or {}
        if not res and not is_live(st) and st.get("state") != "done":
            res = read_json(run / "result.json")        # it may have finished between the two reads
            if not res:
                return emit({"lane_id": lane_id, "status": "error", "error": "supervisor died without a result",
                             "run_dir": str(run)}, 1)
        if res:
            return emit(res, 0 if res.get("status") == "ok" else 1)
        if time.time() >= deadline:
            return emit({"lane_id": lane_id, "status": "running", "state": st.get("state"),
                         "elapsed_s": round(time.time() - st.get("created_at", time.time()), 1),
                         "next": f"lane wait {lane_id} --max 540"}, 3)
        time.sleep(0.5)


def account_label(p: dict) -> str:
    return "claude" if p.get("provider") == "claude" else Path(p.get("codex_home") or "").name


def human() -> bool:
    return sys.stdout.isatty() and os.environ.get("LANE_JSON") != "1"


def ago(ts: float | None) -> str:
    if not ts:
        return "-"
    m = int((time.time() - ts) / 60)
    return f"{m}m ago" if m < 60 else f"{m // 60}h{m % 60:02d}m ago" if m < 1440 else f"{m // 1440}d ago"


def cmd_status(a: argparse.Namespace) -> int:
    rows = []
    for st in sorted(RUNS.glob("*/status.json"), reverse=True)[: (1000 if a.all else 20)]:
        s = read_json(st) or {}
        r = read_json(st.parent / "result.json") or {}
        p = read_json(st.parent / "params.json") or {}
        rows.append({"lane_id": st.parent.name, "state": s.get("state"), "status": r.get("status"),
                     "model": r.get("model") or p.get("model"), "effort": r.get("effort") or p.get("effort"),
                     "profile": r.get("profile") or p.get("profile"), "label": r.get("label") or p.get("label"),
                     "account": account_label(p), "duration_s": r.get("duration_s"),
                     "started": s.get("created_at"), "live": is_live(s), "cwd": p.get("cwd"),
                     "report": r.get("report_path"), "summary_first_line": first_line(r.get("summary") or "")})
    running = len(running_lanes())
    if not human():
        return emit({"lanes": rows, "running": running, "max": MAX_CONCURRENT})
    print(f"{running} of {MAX_CONCURRENT} lanes running. Newest first.\n")
    for r in rows:
        state = "RUNNING" if r["live"] else (r["status"] or r["state"] or "?").upper()
        took = f'{int(r["duration_s"] // 60)}m{int(r["duration_s"] % 60):02d}s' if r["duration_s"] else "-"
        print(f'{state:<19} {r["label"] or "-":<24} {r["model"] or "-"} {r["effort"] or ""}  [{r["profile"] or "no profile"}]  '
              f'account={r["account"] or "-"}  started {ago(r["started"])}  took {took}')
        if r["summary_first_line"] and not r["live"]:
            print(f'{"":<19} says: {r["summary_first_line"][:100]}')
        print(f'{"":<19} id: {r["lane_id"]}' + (f'   report: {r["report"]}' if r["report"] else ""))
    print("\nDetails: lane result <id>.  Live view: lane watch <id>")
    return 0


def describe_event(line: str, root: str = "") -> str | None:
    """One readable line for a Codex --json or claude stream-json event, or None to skip it."""
    try:
        ev = json.loads(line)
    except ValueError:
        return None
    t, it = ev.get("type"), ev.get("item") or {}

    def short(p):
        return p.replace(root + "/", "") if root and isinstance(p, str) else p
    if t == "item.started" and it.get("type") == "command_execution":
        cmd = re.sub(r"^/bin/(z|ba)?sh -lc ", "", it.get("command") or "").strip("'\"")
        return f"  $ {cmd[:160]}"
    if t == "item.completed" and it.get("type") == "command_execution":
        code = it.get("exit_code")
        if code not in (0, "0", None):
            tail = (it.get("aggregated_output") or "").strip().splitlines()[-2:]
            return f"    exit {code}: " + " | ".join(x[:100] for x in tail)
        return None
    if t == "item.completed" and it.get("type") == "file_change":
        paths = [short(c.get("path")) for c in (it.get("changes") or []) if isinstance(c, dict)]
        return "  edited: " + ", ".join(p for p in paths if p)[:200]
    if t == "item.completed" and it.get("type") == "agent_message":
        return "  says: " + " ".join((it.get("text") or "").split())[:220]
    if t in ("error", "turn.failed"):
        msg = ev.get("message") or (ev.get("error") or {}).get("message")
        return f"  ERROR: {str(msg)[:200]}"
    if t == "assistant":            # claude stream-json
        out = []
        for b in (ev.get("message") or {}).get("content", []) or []:
            if b.get("type") == "text" and b.get("text", "").strip():
                out.append("  says: " + " ".join(b["text"].split())[:220])
            elif b.get("type") == "tool_use":
                inp = b.get("input") or {}
                what = inp.get("command") or inp.get("file_path") or inp.get("pattern") or ""
                out.append(f"  {b.get('name')}: {short(str(what))[:160]}")
        return "\n".join(out) or None
    if t == "result":
        return f"  finished: {ev.get('subtype')}"
    return None


def cmd_watch(a: argparse.Namespace) -> int:
    """Follow one lane (or every live lane) as readable lines until it finishes. Ctrl-C to stop."""
    offsets: dict[str, int] = {}
    secrets: dict[str, str] = {}
    one = a.lane_id
    if one and not (RUNS / one).is_dir():
        print(f"unknown lane {one}")
        return 2
    try:
        while True:
            ids = [one] if one else [st.parent.name for st in RUNS.glob("*/status.json") if is_live(read_json(st) or {})]
            if not ids and not one:
                print("no lanes running. (lane status shows recent ones)")
                return 0
            for lid in sorted(ids):
                run = RUNS / lid
                p = read_json(run / "params.json") or {}
                root = p.get("cwd") or ""
                if lid not in secrets:
                    secrets[lid] = worker_secret(p)
                ev_path = run / "events.jsonl"
                if lid not in offsets:
                    offsets[lid] = 0
                    print(f"== {p.get('label') or lid}  {p.get('model')} {p.get('effort')}  [{p.get('profile')}]  {lid}")
                if ev_path.exists():
                    with ev_path.open(errors="replace") as fh:
                        fh.seek(offsets[lid])
                        for line in fh:
                            if not line.endswith("\n"):
                                break
                            offsets[lid] += len(line.encode())
                            d = redact(describe_event(line, root) or "", secrets[lid])
                            if d:
                                print(("[" + (p.get("label") or lid)[:18] + "] " if not one else "") + d, flush=True)
                res = read_json(run / "result.json")
                if one and not res and not is_live(read_json(run / "status.json") or {}):
                    res = read_json(run / "result.json")    # it may have finished between the two reads
                    if not res:
                        print("== ended without a result (its supervisor died)")
                        return 1
                if res and one:
                    print(f"== done: {res.get('status')}  report: {res.get('report_path')}")
                    return 0 if res.get("status") == "ok" else 1
            time.sleep(1.5)
    except KeyboardInterrupt:
        return 0


def cmd_quota(a: argparse.Namespace) -> int:
    home = str(Path(a.codex_home or DEFAULT_HOME).expanduser().absolute())
    q = latest_rate_limit(home) or {}
    marker = capped_marker(home, "openai")
    current = (q.get("resets_at") or 0) > time.time()
    return emit({"codex_home": home, "used_percent": q.get("used_percent"), "resets_at": q.get("resets_at"),
                 "sample_current": current, "short_used_percent": q.get("short_used_percent"),
                 "plan_type": q.get("plan_type"), "sample_ts": q.get("ts"),
                 "lane_points_this_window": lane_points_this_window(home, q.get("resets_at")),
                 "lane_points_budget": WEEKLY_LANE_POINTS, "stop_task_at": QUOTA_STOP_TASK,
                 "stop_review_at": QUOTA_STOP_REVIEW, "capped_marker": marker.read_text()[:300] if marker.exists() else None})


def cmd_cancel(a: argparse.Namespace) -> int:
    run = RUNS / a.lane_id
    if not run.is_dir():
        return emit({"status": "usage_error", "error": f"unknown lane {a.lane_id}"}, 2)
    st = read_json(run / "status.json") or {}
    if st.get("state") == "done":
        return emit({"lane_id": a.lane_id, "status": "not_running"}, 1)
    (run / "cancel").write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    pgid = st.get("codex_pgid")
    if not alive(st.get("supervisor_pid")) and group_alive(pgid):
        # orphaned worker: no supervisor will read the cancel request, so stop the group here
        if not stop_group(pgid):
            return emit({"lane_id": a.lane_id, "status": "error", "error": "worker process group survived SIGKILL",
                         "codex_pgid": pgid}, 1)
        return emit({"lane_id": a.lane_id, "status": "orphan_killed", "codex_pgid": pgid})
    return emit({"lane_id": a.lane_id, "status": "cancel_requested", "next": f"lane wait {a.lane_id} --max 60"})


def build_parser() -> argparse.ArgumentParser:
    ap = JsonArgParser(prog="lane", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=JsonArgParser)
    for name in ("start", "run", "route"):
        s = sub.add_parser(name)
        s.add_argument("--brief", required=True)
        s.add_argument("--cwd", help="working directory (optional and ignored with --answer-only)")
        s.add_argument("--answer-only", action="store_true", help="answer the brief in an empty cwd without coding tools")
        s.add_argument("--web-research", action="store_true", help="allow only keyless Exa tools; requires --answer-only")
        s.add_argument("--profile", default=None, help="profile name from profiles.json, or 'auto'")
        s.add_argument("--retry-of", default=None, help="lane id to escalate from (next profile on the ladder)")
        s.add_argument("--model", default=None)
        s.add_argument("--effort", default=None, choices=EFFORTS)
        s.add_argument("--kind", default=None, choices=("task", "review"))
        s.add_argument("--sandbox", default=None, choices=SANDBOXES)
        s.add_argument("--worktree", action="store_true")
        s.add_argument("--label", default="")
        s.add_argument("--max-time", default=None, type=parse_duration)
        s.add_argument("--provider", default=None, choices=PROVIDERS)
        s.add_argument("--tier", default="default", choices=("default", "fast", "flex"))
        s.add_argument("--network", action="store_true")
        s.add_argument("--add-dir", action="append", default=[])
        s.add_argument("--codex-home", default="")
        s.add_argument("--wait-slot", type=float, default=0.0)
        s.add_argument("--force", action="store_true", help="skip quota/budget/CAPPED preflight")
    w = sub.add_parser("wait")
    w.add_argument("lane_id")
    w.add_argument("--max", type=float, default=540)
    sub.add_parser("result").add_argument("lane_id")
    sub.add_parser("status").add_argument("--all", action="store_true")
    sub.add_parser("quota").add_argument("--codex-home", default="")
    sub.add_parser("cancel").add_argument("lane_id")
    sub.add_parser("watch", help="follow a lane (or all live lanes) as readable lines").add_argument("lane_id", nargs="?")
    return ap


def main(argv: list[str]) -> int:
    if argv[:1] == ["_supervise"]:
        return supervise(argv[1])
    if CONFIG_ERRORS:
        return emit({"status": "usage_error", "error": "; ".join(CONFIG_ERRORS)}, 2)
    try:
        a = build_parser().parse_args(argv)
    except UsageError as exc:
        return emit({"status": "usage_error", "error": str(exc)}, 2)
    try:
        return dispatch(a)
    except UsageError as exc:
        return emit({"status": "usage_error", "error": str(exc)}, 2)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        return emit({"status": "error", "error": f"{type(exc).__name__}: {exc}"[:500]}, 1)


def cmd_result(a: argparse.Namespace) -> int:
    res = read_json(RUNS / a.lane_id / "result.json")
    if not res:
        return emit({"lane_id": a.lane_id, "status": "no_result"}, 1)
    code = 0 if res.get("status") == "ok" else 1
    if not human():
        return emit(res, code)
    print(f'{res.get("status", "?").upper()}  {res.get("label")}  {res.get("model")} {res.get("effort")}  '
          f'[{res.get("profile") or "no profile"}]  account={account_label(res)}  took {res.get("duration_s")}s')
    if res.get("worktree"):
        print(f'branch {res.get("branch")}  worktree {res.get("worktree")}')
    print(f'report: {res.get("report_path")}\n')
    print(res.get("summary") or "")
    return code


def dispatch(a: argparse.Namespace) -> int:
    if a.cmd in ("start", "run", "route"):
        return cmd_start(a, wait_after=a.cmd == "run", route_only=a.cmd == "route")
    if a.cmd == "wait":
        return wait_for(a.lane_id, a.max)
    return {"result": cmd_result, "status": cmd_status, "quota": cmd_quota, "cancel": cmd_cancel, "watch": cmd_watch}[a.cmd](a)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
