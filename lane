# ---------- small helpers ----------

def emit(obj: dict, code: int = 0) -> int:
    print(json.dumps(obj, sort_keys=True))
    return code


def write_json(path: Path, data: dict) -> None:
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1, sort_keys=True))
    os.replace(tmp, path)


def read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def group_alive(pgid: int | None) -> bool:
    """True while any live member of the group exists. macOS answers EPERM for a group holding only zombies."""
    if not pgid:
        return False
    try:
        os.killpg(pgid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def stop_group(pgid: int, reap=lambda: None) -> bool:
    """TERM a process group, then KILL whatever is left; True once no member is alive. Survivors of a dead
    leader count too. `reap` collects our own exited leader first, so a zombie leader doesn't look alive."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        reap()
        if not group_alive(pgid):
            return True
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            return True
        except PermissionError:
            return not group_alive(pgid)
        deadline = time.time() + KILL_GRACE_S
        while time.time() < deadline:
            reap()
            if not group_alive(pgid):
                return True
            time.sleep(0.2)
    return not group_alive(pgid)


def parse_duration(value: str) -> float:
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", str(value).strip())
    if not m:
        raise argparse.ArgumentTypeError(f"invalid duration: {value}")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]


def new_id(label: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")[:24] or "lane"
    return f"{time.strftime('%Y%m%d-%H%M%S')}-{slug}-{os.urandom(2).hex()}"


def keychain(service: str) -> str:
    try:
        out = subprocess.run(["/usr/bin/security", "find-generic-password", "-a", os.environ.get("USER", ""),
                              "-s", service, "-w"], capture_output=True, text=True, timeout=10)
    except Exception:
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def git(cwd: str | Path, *args: str) -> str | None:
    out = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def overlaps(a: str, b: str) -> bool:
    return a == b or a.startswith(b.rstrip("/") + "/") or b.startswith(a.rstrip("/") + "/")


def capped_marker(codex_home: str, provider: str) -> Path:
    return Path(codex_home) / ("CAPPED" if provider == "openai" else f"CAPPED-{provider}")


# ---------- quota telemetry (rollout token_count events; limit_id "codex" only) ----------

def account_homes(codex_home: str) -> list[str]:
    """The lane home plus the home its auth.json links to: same account, so the same weekly quota."""
    homes = [codex_home]
    auth = Path(codex_home) / "auth.json"
    if auth.is_symlink():
        target = str(auth.resolve().parent)
        if target not in homes:
            homes.append(target)
    return homes


def account_id(codex_home: str) -> str:
    """Where the account's real auth.json lives. Homes that share a login share one weekly quota."""
    return str((Path(codex_home) / "auth.json").resolve().parent)


def split_windows(rl: dict) -> tuple[dict | None, dict | None]:
    """Return (weekly, shorter) windows. A window without window_minutes is treated as weekly."""
    weekly = short = None
    for w in (rl.get("primary"), rl.get("secondary")):
        if not isinstance(w, dict):
            continue
        if w.get("window_minutes") in (None, WEEK_MINUTES):
            weekly = weekly or w
        else:
            short = short or w
    return weekly, short


def latest_rate_limit(codex_home: str, since: float = 0.0) -> dict | None:
    """The account's newest weekly reading and newest shorter-window reading, each from its own latest sample."""
    files = []
    for h in account_homes(codex_home):
        files += glob.glob(os.path.join(h, "sessions", "**", "rollout-*.jsonl"), recursive=True)
    files = sorted(files, key=lambda p: os.path.getmtime(p), reverse=True)[:25]
    weekly = short = None              # (timestamp, window, plan_type)
    for path in files:
        if os.path.getmtime(path) < since:
            break
        try:
            with open(path, errors="replace") as fh:
                for line in fh:
                    if '"token_count"' not in line:
                        continue
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    rl = (ev.get("payload") or {}).get("rate_limits") or {}
                    if rl.get("limit_id") != "codex":
                        continue
                    ts = ev.get("timestamp", "")
                    w, sh = split_windows(rl)
                    if w and (weekly is None or ts > weekly[0]):
                        weekly = (ts, w, rl.get("plan_type"))
                    if sh and (short is None or ts > short[0]):
                        short = (ts, sh, rl.get("plan_type"))
        except OSError:
            continue
    if not weekly and not short:
        return None
    ts, w, plan = weekly or (short[0], {}, short[2])
    sample = {"used_percent": w.get("used_percent"), "resets_at": w.get("resets_at"), "plan_type": plan, "ts": ts}
    if short:
        sample["short_used_percent"] = short[1].get("used_percent")
        sample["short_resets_at"] = short[1].get("resets_at")
    return sample


def lane_points_this_window(codex_home: str, resets_at: float | None) -> float:
    """Sum of attributed quota deltas recorded by task lanes on this account inside the current weekly window."""
    if not resets_at:
        return 0.0
    window_start = resets_at - WEEK_MINUTES * 60
    me = account_id(codex_home)
    total = 0.0
    for res in RUNS.glob("*/result.json"):
        r = read_json(res) or {}
        if r.get("kind") != "task" or not r.get("codex_home") or account_id(r["codex_home"]) != me:
            continue
        if (r.get("finished_at") or 0) >= window_start and isinstance(r.get("quota_delta"), (int, float)):
            total += max(0.0, r["quota_delta"])
    return round(total, 2)


def preflight_refusal(provider: str, kind: str, codex_home: str, quota: dict | None) -> dict | None:
    """Why this lane can't start now (a recent usage-limit hit, or the account near its limit), or None."""
    marker = capped_marker(codex_home, provider)
    if marker.exists() and time.time() - marker.stat().st_mtime < CAPPED_HOLD_S:
        return {"status": "capped_preflight", "marker": str(marker), "note": marker.read_text()[:300]}
    if provider == "claude":
        util = claude_weekly_utilization()
        if util is not None and util >= CLAUDE_WEEKLY_STOP:
            return {"status": "capped_preflight", "provider": "claude", "seven_day_utilization": util,
                    "stop_at": CLAUDE_WEEKLY_STOP}
    if not quota:
        return None
    now = time.time()
    short = quota.get("short_used_percent")
    if isinstance(short, (int, float)) and short >= QUOTA_STOP_SHORT and (quota.get("short_resets_at") or 0) > now:
        return {"status": "capped_preflight", "short_used_percent": short, "resets_at": quota.get("short_resets_at")}
    if (quota.get("resets_at") or 0) <= now:
        return None                     # the weekly sample predates the current window
    used = quota.get("used_percent") or 0
    stop = QUOTA_STOP_REVIEW if kind == "review" else QUOTA_STOP_TASK
    if used >= stop:
        return {"status": "capped_preflight", "used_percent": used, "stop_at": stop, "resets_at": quota.get("resets_at")}
    if kind == "task" and WEEKLY_LANE_POINTS > 0:
        spent = lane_points_this_window(codex_home, quota.get("resets_at"))
        if spent >= WEEKLY_LANE_POINTS:
            return {"status": "budget_spent", "lane_points": spent, "budget": WEEKLY_LANE_POINTS,
                    "resets_at": quota.get("resets_at")}
    return None


# ---------- reservations ----------

def is_live(s: dict) -> bool:
    if s.get("state") not in ("starting", "running"):
        return False
    if alive(s.get("supervisor_pid")) or group_alive(s.get("codex_pgid")):
        return True
    return s.get("state") == "starting" and time.time() - (s.get("created_at") or 0) < STARTUP_GRACE_S


def running_lanes() -> list[dict]:
    return [s for st in RUNS.glob("*/status.json") if is_live(s := (read_json(st) or {}))]


# ---------- profiles and routing (deterministic; no model tokens) ----------

def checked_profile_file(path: Path, data) -> dict:
    """A profiles file's top level must be objects all the way down to the profile entries."""
    if not isinstance(data, dict) or any(not isinstance(data.get(k, {}), dict) for k in PROFILE_SECTIONS):
        raise ValueError(f"{path}: expected an object whose {', '.join(PROFILE_SECTIONS)} entries are objects")
    if any(not isinstance(v, dict) for v in data.get("providers", {}).values()):
        raise ValueError(f"{path}: each providers entry must be an object")
    return data


def load_profiles(cwd: str | Path | None = None) -> dict:
    """The shipped profiles.json, then your own $LANE_STATE/profiles.json, then <repo>/.lane/profiles.json.
    Each later file replaces whole entries (a profile, a ladder step, a keyword list, a provider) by name."""
    raw = PROFILES_PATH.read_bytes()
    data = checked_profile_file(PROFILES_PATH, json.loads(raw))
    repo = git(cwd, "rev-parse", "--show-toplevel") if cwd else None
    for key, path in (("user_overrides", STATE / "profiles.json"),
                      ("project_overrides", Path(repo) / ".lane" / "profiles.json" if repo else None)):
        if path and path.is_file():
            text = path.read_bytes()
            over = checked_profile_file(path, json.loads(text))
            if key == "project_overrides" and over.get("providers"):
                # a checkout must not be able to send your API key to a server of its choosing
                raise ValueError(f"{path}: providers can only be set in {STATE / 'profiles.json'}")
            for section in PROFILE_SECTIONS:
                data.setdefault(section, {}).update(over.get(section, {}))
            data[key] = str(path)
            raw += text
    data["hash"] = "sha256:" + hashlib.sha256(raw).hexdigest()[:16]
    return data


def brief_signals(text: str, keywords: dict) -> dict:
    """Countable facts about a brief written to the lane-routing template (Goal / Owned paths / Read / Do)."""
    def items(label: str) -> list[str]:
        m = re.search(rf"^[ \t]*(?:.*?\.[ \t]*)?{label}:[ \t]*(.*)$", text, re.M | re.I)
        if not m:
            return []
        value = m.group(1)
        if not value.strip():          # the list may follow as "- item" lines
            bullets = re.match(r"(?:[ \t]*[-*][ \t]+.+(?:\n|$))+", text[m.end() + 1:])
            found = [b.strip()[1:].strip() for b in bullets.group(0).splitlines()] if bullets else []
            return [x for x in found if x and not re.fullmatch(r"(none|n/a|-)\.?", x, re.I)]
        if re.fullmatch(r"\s*(none|n/a|-)?\s*\.?\s*", value, re.I):
            return []
        return [x for x in re.split(r"[,;]\s*|\s+and\s+", value.strip().rstrip(".")) if x.strip()]
    goal = " ".join(re.findall(r"^[ \t]*Goal:[ \t]*(.+)$", text, re.M | re.I))
    do_block = re.search(r"^\s*Do:\s*\n?(.*?)(?=^\s*(Acceptance|Read|Goal|Repo)\b|\Z)", text, re.M | re.S | re.I)
    do_text = do_block.group(1) if do_block else ""
    do_steps = len(re.findall(r"^\s*\d+[.)]\s", do_text, re.M))
    scope = f"{goal}\n{do_text}".lower()
    hits = {k: sorted({w for w in words if re.search(rf"\b{re.escape(w)}\b", scope)}) for k, words in keywords.items()}
    return {"owned_paths": len(items("Owned paths")), "read_files": len(items("Read")), "do_steps": do_steps,
            "brief_bytes": len(text.encode()), "hard_kw": hits.get("hard", []), "simple_kw": hits.get("simple", []),
            "draft_kw": hits.get("draft", []), "risk_kw": hits.get("risk", [])}


def profile_problem(prof: dict) -> str | None:
    """Why a profile can't be used, or None. Profiles bypass argparse, so check what argparse would have."""
    if not isinstance(prof, dict):
        return "a profile must be a JSON object"
    missing = [f for f in PROFILE_FIELDS if f not in prof]
    if missing:
        return f"missing {', '.join(missing)}"
    if not isinstance(prof["model"], str) or not prof["model"].strip():
        return "model must be a non-empty string"
    for field in ("worktree", "enabled"):
        if field in prof and not isinstance(prof[field], bool):
            return f"{field} must be true or false, not {prof[field]!r}"
    for field, allowed in (("kind", tuple(CONTRACTS)), ("sandbox", SANDBOXES), ("provider", PROVIDERS),
                           ("effort", EFFORTS)):
        if field in prof and prof[field] not in allowed:
            return f"{field} must be one of {', '.join(allowed)}, not {prof[field]!r}"
    try:
        parse_duration(prof["max_time"])
    except argparse.ArgumentTypeError as exc:
        return str(exc)
    return None


def auto_profile(kind: str, sandbox: str, sig: dict) -> tuple[str | None, str | None]:
    """Rule table (family first, then tier). Returns (profile, refusal)."""
    hard, simple, risk = len(sig["hard_kw"]), len(sig["simple_kw"]), len(sig["risk_kw"])
    if kind == "review":
        deep = risk >= 1 or hard >= 2 or sig["brief_bytes"] > 12000
        return ("review-deep" if deep else "review"), None
    if sandbox == "workspace-write":
        if sig["owned_paths"] == 0:
            return None, "owned_paths_missing"
        if risk >= 1:
            return None, "explicit_profile_required"
        hard_impl = sig["owned_paths"] >= 4 or hard >= 2 or sig["do_steps"] > 6 or sig["brief_bytes"] > 4096
        if hard_impl:
            return "implement-hard", None
        light = simple >= 1 and hard == 0 and sig["owned_paths"] <= 2 and sig["brief_bytes"] < 2000
        return ("implement-light" if light else "implement"), None
    if sig["draft_kw"] and hard == 0:
        return "draft", None
    quick = simple >= 1 and hard == 0 and sig["read_files"] <= 2 and sig["brief_bytes"] < 1500
    return ("quick-investigate" if quick else "investigate"), None


def resolve_route(a: argparse.Namespace, brief_text: str) -> tuple[dict | None, dict | None]:
    """Fill model/effort/kind/sandbox/worktree/max_time on `a` from --profile / --retry-of. Returns (routing, error)."""
    routing = {"mode": None, "profile": None, "decided_by": "flags", "overrides": []}
    name = a.profile
    if a.retry_of:
        prev = read_json(RUNS / a.retry_of / "result.json") or {}
        prof = prev.get("profile")
        if not prof:
            return None, {"status": "usage_error", "error": f"--retry-of {a.retry_of}: no profile recorded"}
        nxt = load_profiles(a.cwd)["ladder"].get(prof)
        if nxt in (None, "claude_agent"):
            return None, {"status": "escalate_to_claude", "from_profile": prof,
                          "note": "no stronger lane profile; run this stage as a Claude agent"}
        name, routing["decided_by"] = nxt, "retry"
    if not name:
        a.provider = a.provider or "openai"
        a.model = a.model or "gpt-6-astra"
        a.effort = a.effort or "medium"
        a.kind = a.kind or "task"
        a.sandbox = a.sandbox or "read-only"
        a.max_time = a.max_time if a.max_time is not None else parse_duration("60m")
        return routing, None
    data = load_profiles(a.cwd)
    routing.update(mode="auto" if name == "auto" else "named", profile_set_hash=data["hash"],
                   user_overrides=data.get("user_overrides"), project_overrides=data.get("project_overrides"))
    if name == "auto":
        a.kind = a.kind or "task"
        a.sandbox = a.sandbox or "read-only"
        sig = brief_signals(brief_text, data.get("keywords", {}))
        name, refusal = auto_profile(a.kind, a.sandbox, sig)
        routing.update(signals=sig, decided_by="rules")
        if refusal:
            return None, {"status": refusal, "signals": sig,
                          "note": "name a profile explicitly" if refusal == "explicit_profile_required" else "list Owned paths in the brief"}
    elif routing["decided_by"] != "retry":
        routing["decided_by"] = "explicit"
    prof = data["profiles"].get(name)
    if prof is None:
        return None, {"status": "unknown_profile", "profile": name, "known": sorted(data["profiles"])}
    problem = profile_problem(prof)
    if problem:
        return None, {"status": "bad_profile", "profile": name, "error": problem}
    if prof.get("enabled") is False:
        return None, {"status": "profile_disabled", "profile": name}
    wanted = dict(prof, provider=prof.get("provider", "openai"))
    for field in ("provider", "model", "effort", "kind", "sandbox"):
        given = getattr(a, field)
        if given is not None and given != wanted[field] and not (routing["mode"] == "auto" and field in ("kind", "sandbox")):
            routing["overrides"].append(field)
        setattr(a, field, given if given is not None else wanted[field])
    if a.max_time is None:
        a.max_time = parse_duration(prof["max_time"])
    else:
        routing["overrides"].append("max_time")
    if prof.get("worktree"):
        a.worktree = True
    routing["profile"] = name
    return routing, None


# ---------- self-hosted servers (spark provider) ----------

def provider_endpoint(provider: str, cwd: str | None) -> dict | None:
    """Where a self-hosted provider lives: the "providers" section of your profiles file, else LANE_SPARK_* env.
    Holds the URL and where the key is kept, never the key itself."""
    if provider != "spark":
        return None
    ep = dict(load_profiles(cwd).get("providers", {}).get("spark") or {})
    for field in ("base_url", "api_key_file", "api_key_keychain"):
        if field in ep and not isinstance(ep[field], str):
            raise ValueError(f"providers.{provider}.{field} must be a string")
    ep.setdefault("base_url", os.environ.get("LANE_SPARK_BASE_URL", ""))
    if not ep.get("api_key_file") and not ep.get("api_key_keychain"):
        ep["api_key_keychain"] = os.environ.get("LANE_SPARK_KEYCHAIN_SERVICE", "")
    if ep.get("base_url") and not re.match(r"https?://", ep["base_url"]):
        raise ValueError(f"providers.{provider}.base_url must start with http:// or https://")
    return {k: ep[k] for k in ("base_url", "api_key_file", "api_key_keychain") if ep.get(k)}


class KeySourceError(ValueError):
    """A configured key source that failed. Its message never contains the key."""


def endpoint_key(ep: dict) -> str:
    """The server's API key, read when needed and handed only to the worker's environment. "" when no key source
    is configured; KeySourceError when one is configured but empty, unreadable or malformed."""
    if ep.get("api_key_file"):
        where = f"api_key_file {ep['api_key_file']}"
        try:
            key = Path(ep["api_key_file"]).expanduser().read_text().strip()
        except OSError as exc:
            raise KeySourceError(f"can't read {where} ({type(exc).__name__})") from None
    elif ep.get("api_key_keychain"):
        where = f"Keychain item {ep['api_key_keychain']}"
        key = keychain(ep["api_key_keychain"])
    else:
        return ""
    if not key:
        raise KeySourceError(f"{where} is empty or missing")
    if any(c.isspace() or not c.isprintable() for c in key):
        raise KeySourceError(f"{where} must hold just the key, on one line")
    return key


def redact(text: str, secret: str) -> str:
    """Replace the secret, and its JSON-escaped form, with <redacted>."""
    if not (secret and text):
        return text
    for form in {secret, json.dumps(secret)[1:-1]}:
        text = text.replace(form, "<redacted>")
    return text


def redact_obj(obj: dict, secret: str) -> dict:
    return json.loads(redact(json.dumps(obj), secret)) if secret else obj


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None                    # never carry the Authorization header to another location


def served_models(ep: dict, key: str) -> list[dict]:
    """GET <base_url>/models, without proxies or redirects. Raises OSError or ValueError if the server can't be used."""
    req = urllib.request.Request(ep["base_url"].rstrip("/") + "/models")
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect)
    with opener.open(req, timeout=10) as resp:
        data = json.loads(resp.read())
    models = data.get("data") if isinstance(data, dict) else None
    if not isinstance(models, list) or not all(isinstance(m, dict) for m in models):
        raise ValueError("unexpected /models response")
    return models


def resolve_served_model(a: argparse.Namespace, ep: dict) -> dict | None:
    """Check the server answers, and turn model "auto" into the model it serves. Returns a refusal, or None."""
    if not ep.get("base_url"):
        return {"status": "usage_error",
                "error": f"{a.provider} provider needs providers.{a.provider}.base_url in {STATE / 'profiles.json'}"}
    try:
        key = endpoint_key(ep)
    except KeySourceError as exc:
        return {"status": "usage_error", "error": str(exc)}
    refusal = discover(a, ep, key)
    return redact_obj(refusal, key) if refusal else None


def discover(a: argparse.Namespace, ep: dict, key: str) -> dict | None:
    try:
        served = served_models(ep, key)
    except urllib.error.HTTPError as exc:
        why = f"HTTP {exc.code}" + (" (redirects are not followed)" if 300 <= exc.code < 400 else "")
    except urllib.error.URLError as exc:
        why = f"can't connect: {exc.reason}"
    except (http.client.HTTPException, OSError, ValueError) as exc:
        why = f"bad reply ({type(exc).__name__})"     # never the exception text: it can quote the request
    else:
        why = None
    if why:
        return {"status": "provider_unavailable", "provider": a.provider, "base_url": ep["base_url"], "error": why[:300]}
    ids = [m.get("id") for m in served]
    if not all(isinstance(i, str) and i.strip() for i in ids):
        return {"status": "usage_error", "error": "the server's /models list has an entry without a string id"}
    if a.model == "auto":
        if len(ids) != 1:
            return {"status": "usage_error", "error": "model auto needs exactly one served model", "served": ids}
        a.model = ids[0]
    elif a.model not in ids:
        return {"status": "model_not_served", "model": a.model, "served": ids}
    window = next((m.get("max_model_len") for m in served if m["id"] == a.model), None)
    if isinstance(window, int) and window > 0:
        ep["context_window"] = window
    return None


def worker_secret(p: dict) -> str:
    """The API key a run's worker was given, so it can be scrubbed from the run's records ("" if none)."""
    try:
        if p.get("provider") == "spark":
            return endpoint_key(p.get("endpoint") or {})
        if p.get("provider") == "deepseek":
            return os.environ.get("DEEPSEEK_API_KEY") or keychain("deepseek-api-key")
    except (KeySourceError, OSError):
        pass
    return ""


def scrub_run(run: Path, secret: str) -> None:
    """Replace the key anywhere the worker may have echoed it: report, event stream, logs."""
    if not secret:
        return
    for f in run.iterdir():
        if f.is_file():
            text = f.read_text(errors="replace")
            clean = redact(text, secret)
            if clean != text:
                f.write_text(clean)


