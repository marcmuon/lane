def parse_claude_events(path: Path) -> dict:
    info = {"thread_id": None, "last_agent_message": None, "fatal": None, "usage": {}, "model": None, "rate": None, "error": None}
    try:
        fh = path.open(errors="replace")
    except OSError:
        return info
    with fh:
        for line in fh:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            t = ev.get("type")
            if t == "system" and ev.get("subtype") == "init":
                info["model"] = ev.get("model")
                info["thread_id"] = ev.get("session_id")
            elif t == "rate_limit_event":
                info["rate"] = ev.get("rate_limit_info") or ev
            elif t == "assistant":
                if ev.get("error"):
                    info["error"] = ev.get("error")
                for b in (ev.get("message") or {}).get("content", []) or []:
                    if b.get("type") == "text":
                        info["last_agent_message"] = b.get("text")
            elif t == "result":
                info["thread_id"] = ev.get("session_id") or info["thread_id"]
                if ev.get("result"):
                    info["last_agent_message"] = ev.get("result")
                if ev.get("is_error"):
                    info["fatal"] = f'{ev.get("subtype")}: {ev.get("terminal_reason") or ""} {str(ev.get("result") or "")[:300]}'
                info["usage"] = ev.get("usage") or {}
    return info


def claude_weekly_utilization() -> float | None:
    q = read_json(CLAUDE_QUOTA_FILE) or {}
    if (q.get("seven_day_resets_at") or 0) and q["seven_day_resets_at"] < time.time():
        return None
    return q.get("seven_day")


def record_claude_rate(rate: dict | None) -> None:
    if not rate:
        return
    windows = rate.get("unifiedWindows") or {}
    seven = (windows.get("seven_day") or {}) if windows else ({} if rate.get("rateLimitType") != "seven_day" else rate)
    util, resets = seven.get("utilization"), seven.get("resetsAt")
    if util is None:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "claude-quota.lock").open("a+") as lock:   # concurrent finishers must not lose a higher reading
        fcntl.flock(lock, fcntl.LOCK_EX)
        old = read_json(CLAUDE_QUOTA_FILE) or {}
        old_resets = old.get("seven_day_resets_at")
        if isinstance(resets, (int, float)) and isinstance(old_resets, (int, float)):
            if resets < old_resets - 3600:
                return                     # a late reading from a window that has since reset
            if resets <= old_resets + 3600:
                util = max(util, old.get("seven_day") or 0)   # same window: lanes finish out of order
        write_json(CLAUDE_QUOTA_FILE, {"seven_day": util, "seven_day_resets_at": resets,
                                       "five_hour": (windows.get("five_hour") or {}).get("utilization"), "ts": time.time()})

